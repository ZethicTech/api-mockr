{
  "name": "@zethictech/mockr",
  "version": "0.1.0",
  "description": "Lightweight local mock API server with a web UI, JavaScript handlers and hot reload",
  "license": "MIT",
  "bin": {
    "mockr": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev": "npm run build:server && (npm run build:ui -- --watch & node dist/cli/index.js --dir demo)",
    "start": "node dist/cli/index.js",
    "test": "npm run build:server && node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "ajv": "^8.17.1",
    "chokidar": "^4.0.3",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.5",
    "preact": "^10.29.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "keywords": [
    "mock",
    "mock-server",
    "mock-api",
    "api",
    "rest",
    "testing",
    "development",
    "hot-reload"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZethicTech/api-mockr.git"
  },
  "homepage": "https://github.com/ZethicTech/api-mockr#readme",
  "bugs": {
    "url": "https://github.com/ZethicTech/api-mockr/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
